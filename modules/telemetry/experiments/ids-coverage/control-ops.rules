# Explainable rules for the coverage experiment: flag DNP3 and Modbus
# operations that write to or control an outstation. Throwaway, not a ruleset.
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 WRITE (FC 2)"; dnp3_func:write; sid:9000002; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 SELECT (FC 3)"; dnp3_func:select; sid:9000003; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 OPERATE (FC 4)"; dnp3_func:operate; sid:9000004; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 DIRECT_OPERATE (FC 5)"; dnp3_func:direct_operate; sid:9000005; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 DIRECT_OPERATE_NR (FC 6)"; dnp3_func:direct_operate_nr; sid:9000006; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 COLD_RESTART (FC 13)"; dnp3_func:cold_restart; sid:9000013; rev:1;)
alert dnp3 any any -> any any (msg:"OTSEC-EXP DNP3 WARM_RESTART (FC 14)"; dnp3_func:warm_restart; sid:9000014; rev:1;)
alert modbus any any -> any any (msg:"OTSEC-EXP Modbus write access"; modbus: access write; sid:9000100; rev:1;)
