# HR-23's sanitizer fuzz run: its pins and settings (brief P4-4-HR23-FUZZ;
# docs/phase4/D4-hr23-design.md, section 4.6, "The settings, pinned before
# the run"). Read by fuzz.sh, which refuses to build or run on any file that
# does not match its pin. Zeek's tarball, its signature, the key and option
# (i)'s patch are pinned in ../build.env and checked by `build.sh verify`.
# Every setting here is the same for both builds, C1p and C2, and for the
# three targets.
#
# The harness, the same for both builds (D6's B3 on 9919fd24): the line
# that adds the dnp3_udp target and links the mutator, and the mutator.
HR23_FUZZ_HARNESS_SHA256=a3e459dd8e457e02b1125d1f7e51d122dd8cb5cf7e28a38f7f84edb00122dc6c
HR23_FUZZ_MUTATOR_SHA256=992e2c93a93854e349d6addf49bef8028de1d09aebb872beeaf9d7e978813f42
# The seed conversion and its output: the script, and the corpus it makes
# from Zeek's dnp3_tcp corpus, GT-PCAP's HR-23 cases and malformed set
# (hr23_cases.py) and D4's d4u-* inputs (dispatch_unit.py). The corpus hash
# is the SHA-256 of seeds.py's manifest (one "sha256  target/name" line per
# seed, sorted).
HR23_FUZZ_SEEDS_SHA256=51b75996677b8ded51a81f9cb4104a3dab1c5938c6178bed5af00757b6bc02b8
HR23_FUZZ_CORPUS_SHA256=f7928faa3eb9c6d85ba483e9873fef20f82b446d88b731c8bcf08f630bb62590
# The compiler, by major version: clang, its libFuzzer and sanitizer
# runtimes, and llvm-profdata and llvm-cov of the same version. The runner
# image's clang-18 packages are not pinned by version; fuzz.sh records
# them, and the runner image's name and version, in the build record.
HR23_FUZZ_CLANG=18
# The sanitizers, as Zeek's own --sanitizers option takes them. Zeek's CMake
# adds -fno-sanitize-recover=undefined, -fno-omit-frame-pointer and -O1 for
# them (CMakeLists.txt, ZEEK_SANITIZERS); fuzz.sh checks that the build
# lines carry -fno-sanitize-recover=undefined, so that a UBSan report stops
# the run and is counted.
HR23_FUZZ_SANITIZERS=address,undefined,fuzzer-no-link
# Both builds are instrumented for coverage alike, so the patched build's
# campaign corpus is replayed for coverage on the build that fuzzed it.
HR23_FUZZ_COVERAGE_FLAGS="-fprofile-instr-generate -fcoverage-mapping"
# libFuzzer's options, the same for every campaign and every replay.
# -timeout: seconds per input before a libFuzzer timeout, a report.
# -rss_limit_mb: an out-of-memory stop above it, a report.
# -max_len: octets per input; seeds.py drops a seed's trailing chunks to fit.
# -seed: libFuzzer's random seed.
# -detect_leaks=0: LSan is off. Zeek keeps state across inputs that LSan
#   would report at each input's end; a leak is not counted (a stated limit).
# -report_slow_units: above -timeout, so that no slow-unit file is written
#   (a slow input is not a report).
HR23_FUZZ_TIMEOUT=25
HR23_FUZZ_RSS_LIMIT_MB=4096
HR23_FUZZ_MAX_LEN=8192
HR23_FUZZ_SEED=1
HR23_FUZZ_DETECT_LEAKS=0
HR23_FUZZ_SLOW_UNITS=100000
# Seconds of fuzzing per target per build (D1 6862064732, point 2).
HR23_FUZZ_SECONDS=1800
# The sanitizer runtimes' options. halt_on_error and abort_on_error make
# every report end the process, which libFuzzer counts; detect_leaks=0 as
# above; symbolize=0, since no trace is ever printed or kept beyond the
# runner.
HR23_FUZZ_ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=0:symbolize=0
HR23_FUZZ_UBSAN_OPTIONS=halt_on_error=1:abort_on_error=1:print_stacktrace=0:symbolize=0
