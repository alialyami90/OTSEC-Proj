--- run.sh	2026-10-23 15:45:41.000000000 +0000
+++ run_a6.sh	2026-10-23 15:48:01.414187842 +0000
@@ -167,6 +167,21 @@
   "eof_after_s=$lat; new connection: $after" \
   "$([ "$lat" != n/a ] && [ "$after" != "REPLY OK DATA" ] && echo 1 || echo 0)"
 
+
+# --- A6 T9: is killing the session a revocation? Reconnect with the same key ---
+tunnel 15009 "$APPROVED_IED" "$APPROVED_PORT"
+out=$(python3 "$HERE/probe.py" 127.0.0.1 15009 "READ SER")
+result T9 "A6: after kill, same key re-establishes access (kill is not revocation)" "$out" "$([ "$out" = "REPLY OK DATA" ] && echo 1 || echo 0)"
+
+# --- A6 T10: stdio forwarding (-W) to an unapproved device --------------------
+out=$(printf 'READ SER\n' | timeout 5 "${SSH[@]}" -W "$OTHER_IED:$APPROVED_PORT" "$USER_NAME@127.0.0.1" 2>&1)
+n=$(ied_lines other connect)
+result T10 "A6: -W to unapproved device refused; 0 connects" "out='${out//$'\n'/ }'; device connects=$n" "$([[ "$out" != *"OK DATA"* ]] && [ "$n" = 0 ] && echo 1 || echo 0)"
+
+# --- A6 T11: sftp subsystem request -------------------------------------------
+out=$(printf 'ls /\n' | timeout 5 sftp -b - -i "$WORK/user_key" -P "$SSHD_PORT" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$USER_NAME@127.0.0.1" 2>&1); rc=$?
+result T11 "A6: sftp subsystem refused" "rc=$rc out='${out//$'\n'/ }'" "$([ $rc != 0 ] && [[ "$out" != *"/etc"* ]] && echo 1 || echo 0)"
+
 echo "# sshd evidence (refusals):"
 grep -Ei 'refus|prohibit|not permitted|denied|Received request' "$WORK/sshd.log" | sed 's/^/#   /' | head -20
 echo "# summary: $PASS pass, $FAIL fail"
