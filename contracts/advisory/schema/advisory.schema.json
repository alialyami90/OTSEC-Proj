{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.advisory/0.1",
  "title": "otsec.advisory/0.1 signed advisory set (C11)",
  "description": "Structural schema only. The file a node reads is the envelope; its payload, once the signature verifies, is a set. Cross-field rules (unique entry ids and item names, no test_only entry in a release set, sel-fid ranges on one branch with introduced below fixed, exact ranges without endpoints, control items as mitigations only with op present, values only for in and not-in, the reserved name firmware-version, attributes BFID and configVersion refused, the payload at most 1 MiB and the file at most MaxEnvelopeBytes) are enforced by Set.Validate and Verify in contracts/advisory.",
  "$defs": {
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "algorithm", "key_id", "payload", "signature"],
      "properties": {
        "contract": {"type": "string", "pattern": "^otsec\\.advisory/0\\.[0-9]+$"},
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519-[0-9a-f]{16}$"},
        "payload": {"type": "string", "contentEncoding": "base64", "minLength": 1, "maxLength": 1398104},
        "signature": {"type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88}
      }
    },
    "set": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "set_id", "version", "issued_at", "purpose", "publisher", "entries"],
      "properties": {
        "contract": {"const": "otsec.advisory/0.1"},
        "set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "integer", "minimum": 1},
        "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "purpose": {"enum": ["release", "test"]},
        "publisher": {"type": "string", "maxLength": 128},
        "entries": {"type": ["array", "null"], "maxItems": 2048, "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "test_only", "title", "sources", "affected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "test_only": {"type": "boolean"},
        "title": {"type": "string", "maxLength": 256},
        "sources": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/source"}},
        "affected": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/affected"}},
        "preconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/item"}},
        "mitigations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "published"],
      "properties": {
        "kind": {"enum": ["vendor-advisory", "cve", "national-advisory", "other"]},
        "ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "url": {"type": "string", "pattern": "^https://", "maxLength": 512},
        "published": {"type": "string", "format": "date"},
        "retrieved": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "affected": {
      "type": "object", "additionalProperties": false, "required": ["vendor", "product", "scheme"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "scheme": {"enum": ["sel-fid", "exact"]},
        "ranges": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/range"}},
        "versions": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "properties": {"introduced": {"type": "string"}, "fixed": {"type": "string"}}
    },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "key", "op"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "kind": {"enum": ["setting", "service", "attribute", "control"]},
        "key": {"type": "string", "minLength": 1, "maxLength": 128},
        "op": {"enum": ["in", "not-in", "present", "absent"]},
        "values": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}
      }
    }
  }
}
