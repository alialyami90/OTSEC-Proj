{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.asset/0.1#capability-profile",
  "title": "otsec.asset/0.1 capability profile (C1)",
  "description": "Structural schema only. Cross-field rules (operations only with mechanism adapter-operation, mechanism none only with status unsupported or unknown, a citation for every status but unknown, a firmware allowlist for any profile that sends adapter operations, max_read_rows exactly when event retrieval uses an adapter operation, session_limits exactly when the profile sends adapter operations, a failed-auth floor longer than the idle timeout, secret_policy exactly when the family takes a password) are enforced by CapabilityProfile.Validate in contracts/asset.",
  "type": "object",
  "required": ["schema", "kind", "profile_id", "version", "vendor", "product_family", "device_class", "firmware", "capabilities"],
  "properties": {
    "schema": {"type": "string", "pattern": "^otsec\\.asset/0\\.(0|[1-9][0-9]{0,3})$"},
    "kind": {"const": "capability-profile"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "product_family": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "device_class": {"$ref": "#/$defs/deviceClass"},
    "firmware": {
      "type": "object", "required": ["allowlist"],
      "properties": {"allowlist": {"type": "string", "description": "A firmware allowlist in the register package (TODO(C3)), or \"none\"."}}
    },
    "pre_credential": {"type": "array", "items": {"type": "string"}, "description": "Attributes the family reports before authentication."},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object", "required": ["capability", "mechanism", "status"],
        "properties": {
          "capability": {"$ref": "#/$defs/capabilityName"},
          "mechanism": {"$ref": "#/$defs/mechanism"},
          "operations": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"}},
          "status": {"$ref": "#/$defs/capabilityStatus"},
          "citation": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "max_read_rows": {"type": "integer", "minimum": 1, "maximum": 2048, "description": "Most rows one native read may hold (D1-12); at most otsec.event MaxAlignRows."},
    "session_limits": {
      "type": "object",
      "required": ["max_concurrent_sessions", "min_interval_ms", "password_attempts", "idle_timeout_ms", "failed_auth_floor_ms", "citation"],
      "description": "Per-family session timing and counts (D1-18).",
      "properties": {
        "max_concurrent_sessions": {"type": "integer", "minimum": 1},
        "min_interval_ms": {"type": "integer", "minimum": 1},
        "password_attempts": {"enum": [0, 1]},
        "idle_timeout_ms": {"type": "integer", "minimum": 0},
        "failed_auth_floor_ms": {"type": "integer", "minimum": 0},
        "citation": {"type": "string", "minLength": 1}
      }
    },
    "secret_policy": {
      "type": "object",
      "required": ["min_len", "max_len", "allowed", "citation"],
      "description": "The family's write-time password rule (D1-19). Exactly one of mnemonic_len and whole_word.",
      "properties": {
        "min_len": {"type": "integer", "minimum": 1},
        "max_len": {"type": "integer", "minimum": 1, "maximum": 64},
        "allowed": {"type": "string", "minLength": 1, "description": "RE2, matched against the whole secret."},
        "mnemonic_len": {"type": "integer", "minimum": 1},
        "whole_word": {"type": "boolean"},
        "citation": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "capabilityName": {"enum": ["identification", "event-retrieval", "event-push", "configuration-retrieval", "health", "time-quality"]},
    "mechanism": {"enum": ["adapter-operation", "syslog-receive", "passive", "operator-entry", "none"]},
    "deviceClass": {"enum": ["protective-relay", "ied-other", "rtu", "automation-controller", "communications-processor", "ethernet-switch", "router", "security-gateway", "firewall", "time-server", "server", "engineering-workstation", "hmi", "historian", "meter", "port-server", "unknown"]},
    "capabilityStatus": {"enum": ["hardware-verified", "documented-untested", "simulated", "inferred-owner-accepted", "unsupported", "unknown"]}
  }
}
