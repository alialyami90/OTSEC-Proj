{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otsec.local/schema/otsec.config/0.3/snapshot.schema.json",
  "title": "otsec.config/0.3 snapshot (C9)",
  "description": "One configuration read of one asset: every settings class of its rule, in the rule's order, each pointing at its reply in the session's C2 transcript by span and SHA-256. The bytes are only in the transcript (D4-8). Rules the schema cannot state (class order, sensitivity, which classes may be absent, the tokenization) are in contracts/config (Validate, CheckAgainst).",
  "type": "object",
  "required": ["schema", "kind", "asset_id", "invocation_id", "operation_id", "adapter", "register_version", "target", "retrieved_at", "rule", "transcript", "sections"],
  "properties": {
    "schema": {"type": "string", "pattern": "^otsec\\.config/0\\.(0|[1-9][0-9]{0,3})$"},
    "kind": {"const": "config.snapshot"},
    "asset_id": {"$ref": "#/$defs/uuid"},
    "invocation_id": {"$ref": "#/$defs/uuid"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"},
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "register_version": {"type": "integer", "minimum": 1},
    "target": {"enum": ["device-observed", "simulated"]},
    "retrieved_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "rule": {"type": "string", "minLength": 1},
    "transcript": {
      "type": "object",
      "required": ["ref", "sha256", "length"],
      "properties": {
        "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "length": {"type": "integer", "minimum": 1}
      }
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sectionState": {"enum": ["absent", "present"]},
    "span": {
      "type": "object",
      "required": ["offset", "length"],
      "properties": {"offset": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 1}}
    },
    "section": {
      "type": "object",
      "required": ["command", "class", "state", "sensitive", "span", "sha256"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "class": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"},
        "state": {"$ref": "#/$defs/sectionState"},
        "sensitive": {"type": "boolean"},
        "span": {"$ref": "#/$defs/span"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "settings": {"type": "array", "items": {"$ref": "#/$defs/setting"}}
      }
    },
    "setting": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]{0,15}$"},
        "value": {"type": "string", "pattern": "^[!-~](?:[ -~]*[!-~])?$"}
      }
    }
  }
}
