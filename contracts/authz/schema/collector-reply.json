{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.5/collector-reply",
  "title": "Collector reply (C7). Anything but status 'accepted' with no refusal is a refusal; unknown refusal codes read as refused_unknown.",
  "type": "object",
  "required": [
    "contract",
    "request_id",
    "status",
    "collector_seq"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^otsec\\.authz/0\\.(0|[1-9][0-9]*)$"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "refused"
      ]
    },
    "collector_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "C7-A5-2: the collector's persisted, contiguous number for this decision. The matching C8 record carries it, so an omitted record shows as a gap."
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "refusal": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "malformed",
            "oversize",
            "unknown_field",
            "contract_mismatch",
            "invalid",
            "principal_not_permitted",
            "unknown_operation",
            "not_invocable",
            "bad_params",
            "asset_not_enrolled",
            "credential_mismatch",
            "credential_unusable",
            "register_unverified",
            "register_version",
            "policy_version",
            "busy",
            "rate_limited",
            "secret_rejected",
            "collector_state_unavailable",
            "suspension_mismatch",
            "asset_suspended",
            "admin_unverified",
            "refused_unknown"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        },
        "suspension": {
          "type": "object",
          "description": "Since 0.3. The asset suspension the collector holds: always with asset_suspended, and with suspension_mismatch when the collector holds a suspension other than the one the clear named. Never sent in reply to a request stamped before 0.3.",
          "required": [
            "reason",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "identity-mismatch",
                "auth-failed",
                "password-prompt-absent",
                "language-not-english",
                "firmware-not-allowlisted",
                "unexpected-access-level"
              ]
            },
            "code": {
              "type": "string",
              "description": "The C2 outcome code that set the suspension; the reader checks it is known and suspends with reason. Absent for a suspension recorded before the collector kept codes, which the node does not adopt.",
              "pattern": "^(refused|failed)\\.[a-z][a-z0-9_]{0,63}$"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "check": {
          "enum": [
            "envelope",
            "key",
            "signature",
            "payload",
            "binding",
            "window",
            "replay",
            "capacity"
          ],
          "description": "Since 0.4, with admin_unverified only: the check the admin-signed request failed. Never sent in reply to a request stamped before 0.4."
        }
      }
    },
    "repeat_of": {
      "type": "integer",
      "minimum": 1,
      "description": "Since 0.5, on an accepted reply to admin-signed bytes the collector had already accepted: the collector_seq of that first decision, lower than this reply's own. The collector did nothing again. Only with admin. Never on a reply stamped before 0.5."
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admin_key_id",
        "principal",
        "nonce",
        "payload_sha256"
      ],
      "properties": {
        "admin_key_id": {
          "type": "string",
          "pattern": "^ed25519-[0-9a-f]{16}$"
        },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "human"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
            }
          }
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the signed payload bytes as sent: the node acts only on an acceptance of the bytes it sent."
        }
      },
      "description": "Since 0.5, on every accepted reply to an admin-signed request stamped 0.5 or later, and on no other reply: what the collector verified."
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "accepted"
        }
      },
      "not": {
        "required": [
          "refusal"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "refused"
        }
      },
      "required": [
        "refusal"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "repeat_of"
            ]
          },
          {
            "required": [
              "admin"
            ]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "repeat_of"
        ]
      },
      "then": {
        "required": [
          "admin"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "repeat_of"
            ]
          },
          {
            "required": [
              "admin"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "not": {
              "enum": [
                "otsec.authz/0.0",
                "otsec.authz/0.1",
                "otsec.authz/0.2",
                "otsec.authz/0.3",
                "otsec.authz/0.4"
              ]
            }
          }
        }
      }
    }
  ]
}
