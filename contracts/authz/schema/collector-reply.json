{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.4/collector-reply",
  "title": "Collector reply (C7). Anything but status 'accepted' with no refusal is a refusal; unknown refusal codes read as refused_unknown.",
  "type": "object",
  "required": [
    "contract",
    "request_id",
    "status",
    "collector_seq"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^otsec\\.authz/0\\.(0|[1-9][0-9]*)$"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "refused"
      ]
    },
    "collector_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "C7-A5-2: the collector's persisted, contiguous number for this decision. The matching C8 record carries it, so an omitted record shows as a gap."
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "refusal": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "malformed",
            "oversize",
            "unknown_field",
            "contract_mismatch",
            "invalid",
            "principal_not_permitted",
            "unknown_operation",
            "not_invocable",
            "bad_params",
            "asset_not_enrolled",
            "credential_mismatch",
            "credential_unusable",
            "register_unverified",
            "register_version",
            "policy_version",
            "busy",
            "rate_limited",
            "secret_rejected",
            "collector_state_unavailable",
            "suspension_mismatch",
            "asset_suspended",
            "admin_unverified",
            "refused_unknown"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        },
        "suspension": {
          "type": "object",
          "description": "Since 0.3. The asset suspension the collector holds: always with asset_suspended, and with suspension_mismatch when the collector holds a suspension other than the one the clear named. Never sent in reply to a request stamped before 0.3.",
          "required": [
            "reason",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "identity-mismatch",
                "auth-failed",
                "password-prompt-absent",
                "language-not-english",
                "firmware-not-allowlisted",
                "unexpected-access-level"
              ]
            },
            "code": {
              "type": "string",
              "description": "The C2 outcome code that set the suspension; the reader checks it is known and suspends with reason. Absent for a suspension recorded before the collector kept codes, which the node does not adopt.",
              "pattern": "^(refused|failed)\\.[a-z][a-z0-9_]{0,63}$"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "check": {
          "enum": [
            "envelope",
            "key",
            "signature",
            "payload",
            "binding",
            "window",
            "replay",
            "capacity"
          ],
          "description": "Since 0.4, with admin_unverified only: the check the admin-signed request failed. Never sent in reply to a request stamped before 0.4."
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "accepted"
        }
      },
      "not": {
        "required": [
          "refusal"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "refused"
        }
      },
      "required": [
        "refusal"
      ]
    }
  ]
}
