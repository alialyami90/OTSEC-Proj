{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.7/credential-status",
  "title": "Credential status (C7), reported by the collector. No secret and nothing derived from one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_id",
    "version",
    "state",
    "since"
  ],
  "properties": {
    "ref_id": {
      "type": "string",
      "pattern": "^cred_[a-z0-9]{8,40}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "reason": {
      "enum": [
        "auth-failed",
        "password-prompt-absent",
        "unexpected-access-level",
        "identity-mismatch",
        "rotated",
        "compromised",
        "asset-decommissioned",
        "operator"
      ]
    },
    "since": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "reason"
          ]
        }
      },
      "else": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
