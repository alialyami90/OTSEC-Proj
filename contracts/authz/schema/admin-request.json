{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.6/admin-request",
  "title": "Admin-signed request payload (C7 0.4, D2-11; node bodies since 0.5; configuration bodies since 0.6). Strict. Decoded only after the signature verifies. Every field is signed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "principal",
    "admin_key_id",
    "node_id",
    "install_key_id",
    "nonce",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "format": {
      "const": "otsec.authz.admin-request/0.4"
    },
    "kind": {
      "enum": [
        "credential.install",
        "credential.revoke",
        "credential.clear_suspension",
        "asset.clear_suspension",
        "node.quarantine_clear",
        "node.seq_reset_ack",
        "node.change_approval",
        "node.baseline_ack"
      ],
      "description": "Must equal the request's kind."
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "schedule",
            "node",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
        }
      },
      "description": "A person; must equal on_behalf_of and the principal the key is pinned for."
    },
    "admin_key_id": {
      "type": "string",
      "pattern": "^ed25519-[0-9a-f]{16}$",
      "description": "Must equal admin_signed.key_id."
    },
    "node_id": {
      "type": "string",
      "description": "Must equal the collector's node ID (C7 node ID rule)."
    },
    "install_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Must equal the collector's current install key ID."
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "16 random bytes, base64url without padding. Single use: the collector spends it durably before any decision."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC. At most 2 minutes ahead of the collector's clock."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC. After issued_at and the collector's clock, and at most 15 minutes after either."
    },
    "credential_install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sealed"
      ],
      "properties": {
        "ref": {
          "$ref": "otsec.authz/0.6/credential-ref"
        },
        "sealed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "recipient_key_id",
            "ephemeral_public_key",
            "nonce",
            "ciphertext"
          ],
          "properties": {
            "alg": {
              "const": "x25519-hkdf-sha256-aes256gcm"
            },
            "recipient_key_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "ephemeral_public_key": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 44,
              "maxLength": 44
            },
            "nonce": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 16,
              "maxLength": 16
            },
            "ciphertext": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 24,
              "maxLength": 108
            }
          }
        }
      }
    },
    "credential_revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "reason"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^cred_[a-z0-9]{8,40}$"
        },
        "reason": {
          "enum": [
            "rotated",
            "compromised",
            "asset-decommissioned",
            "operator"
          ]
        }
      }
    },
    "credential_clear_suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "version"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^cred_[a-z0-9]{8,40}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset_clear_suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "ref"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "The C2 invocation ID whose outcome suspended the asset. The collector clears only when this, the administrator's clear-suspension.json and its own record of the suspension all match."
        }
      },
      "description": "Since 0.2 (D2-15). Sent by the node, on its own behalf, after it recorded its own asset.suspension_clear."
    },
    "node_quarantine_clear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "manifest_sha256"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the quarantine manifest the administrator reviewed (D3-1)."
        }
      },
      "description": "Since 0.5. An administrator's clear of one quarantine the node holds. The collector checks it and changes nothing of its own; the node clears only after the collector accepts."
    },
    "node_seq_reset_ack": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0,
      "description": "Since 0.5. Acknowledges a collector_seq reset. Empty: the install key acknowledged is install_key_id, which the collector refuses unless it is its current key."
    },
    "node_change_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "baseline_digest",
        "window_start",
        "window_end",
        "reason"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "baseline_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The configuration baseline the change is approved against: sha256: and the SHA-256 of the acknowledged C9 snapshot's exact stored bytes (D4-4 item 5)."
        },
        "window_start": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339, UTC, canonical form."
        },
        "window_end": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339, UTC, canonical form. After window_start, at most 24 hours after it (MaxApprovalWindow), and not yet passed when the collector verifies the request."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Printable UTF-8, at most 256 bytes (MaxApprovalReason), no control character."
        }
      },
      "description": "Since 0.6 (P4-A3, D4-2). Approves a change to one asset's configuration in advance. The approver, nonce and expiry are the envelope's. A change counts as approved only if the collector's collector_seq for this approval is below that of the read that found it; the window bounds when the change may happen."
    },
    "node_baseline_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "baseline_digest"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "kind": {
          "enum": [
            "configuration",
            "event"
          ]
        },
        "baseline_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "sha256: and the SHA-256 of the baseline record's exact stored bytes (C9 snapshot or C10 baseline, D4-4 item 5). The node adopts it only if it holds a baseline of that asset and kind with that hash."
        }
      },
      "description": "Since 0.6 (P4-A3). Acknowledges one baseline as the asset's baseline of its kind. Only an acknowledgement moves a baseline."
    }
  },
  "oneOf": [
