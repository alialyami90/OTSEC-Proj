{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.1/credential-ref",
  "title": "CredentialRef (C7): opaque handle to one device credential; never contains the secret",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "asset_id",
    "node_id",
    "transport",
    "purpose",
    "access_level",
    "downstream_security",
    "version",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cred_[a-z0-9]{8,40}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "TODO(C1): C1 asset ID"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "TODO(C4): C4 node ID"
    },
    "transport": {
      "enum": [
        "telnet",
        "serial",
        "ssh"
      ]
    },
    "purpose": {
      "const": "collect-readonly"
    },
    "access_level": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,15}$"
    },
    "downstream_security": {
      "enum": [
        "encrypted-authenticated",
        "encrypted-weak",
        "plaintext-unauthenticated"
      ]
    },
    "plaintext_scope": {
      "const": "lab-only"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "created_by": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "schedule",
                "node",
                "system"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "enum": [
              "telnet",
              "serial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "plaintext_scope"
        ],
        "properties": {
          "downstream_security": {
            "const": "plaintext-unauthenticated"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "plaintext_scope"
          ]
        }
      }
    }
  ]
}
