{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.8/credential-ref",
  "title": "CredentialRef (C7): opaque handle to one device credential; never contains the secret",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "asset_id",
    "node_id",
    "endpoint_id",
    "transport",
    "purpose",
    "access_level",
    "downstream_security",
    "version",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cred_[a-z0-9]{8,40}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "TODO(C1): C1 asset ID"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "contracts/node IDPattern (D1-1)"
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "TODO(C1): the C1 endpoint this credential is sent over (C7-A2-6)"
    },
    "transport": {
      "enum": [
        "telnet",
        "ssh",
        "snmpv3"
      ],
      "description": "C1 transport tokens; serial is out of 0.1 (C7-A2); snmpv3 from 0.8. v1 and v2c are not transports."
    },
    "purpose": {
      "const": "collect-readonly"
    },
    "access_level": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_-]{0,15}$",
      "not": {
        "const": "0"
      },
      "description": "The register's access level token, checked against the verified register with CheckAccessLevel (C7-A6-1). Never 0. Empty for snmpv3, and only there (0.8)."
    },
    "downstream_security": {
      "enum": [
        "encrypted-authenticated",
        "encrypted-weak",
        "plaintext-unauthenticated"
      ]
    },
    "plaintext_scope": {
      "const": "lab-only"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "created_by": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "schedule",
                "node",
                "system"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "usm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_name",
        "auth",
        "priv",
        "engine_id",
        "sole_device_attested"
      ],
      "description": "0.8: the snmpv3 credential's USM user, required for snmpv3 and only there. The sealed secret is the localized keys (authz.USMSecretLen), never the password.",
      "properties": {
        "user_name": {
          "type": "string",
          "pattern": "^[!-~]{1,32}$"
        },
        "auth": {
          "enum": [
            "hmac-sha-256",
            "hmac-sha-512"
          ]
        },
        "priv": {
          "const": "aes-128"
        },
        "engine_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){5,32}$",
          "description": "the authoritative engine ID the keys are localized to, pinned at commissioning (HR-16)"
        },
        "sole_device_attested": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "enum": [
              "telnet",
              "serial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "plaintext_scope"
        ],
        "properties": {
          "downstream_security": {
            "const": "plaintext-unauthenticated"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "plaintext_scope"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "snmpv3"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "required": [
          "usm"
        ],
        "properties": {
          "access_level": {
            "const": ""
          },
          "downstream_security": {
            "const": "encrypted-authenticated"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "usm"
          ]
        },
        "properties": {
          "access_level": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
