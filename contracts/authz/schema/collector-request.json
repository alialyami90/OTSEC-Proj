{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otsec.authz/0.6/collector-request",
  "title": "Collector request (C7). Strict: unknown fields, duplicate keys and trailing data are rejected. Only 'run' can lead to device I/O.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "request_id",
    "on_behalf_of",
    "policy_version"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^otsec\\.authz/0\\.(0|[1-9][0-9]*)$",
      "description": "Any minor of major 0 is read (contracts/README.md). asset.clear_suspension needs 0.2 or later; admin_signed needs 0.4 or later; node.quarantine_clear and node.seq_reset_ack need 0.5 or later, node.change_approval and node.baseline_ack need 0.6 or later, and all four are only ever admin-signed."
    },
    "kind": {
      "enum": [
        "run",
        "credential.install",
        "credential.revoke",
        "credential.clear_suspension",
        "asset.clear_suspension",
        "node.quarantine_clear",
        "node.seq_reset_ack",
        "node.change_approval",
        "node.baseline_ack"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "on_behalf_of": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "schedule",
            "node",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
        }
      }
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "operation_id",
        "params",
        "register_version"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
          "description": "C3 operation ID; must be a read-only operation in the active register"
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\x20-\\x7e]+$"
          }
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^cred_[a-z0-9]{8,40}$",
          "description": "Absent for a level 0 operation (sel.id), required for any other; the collector checks this against the register (C7-A2-5)."
        },
        "register_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "credential_install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sealed"
      ],
      "properties": {
        "ref": {
          "$ref": "otsec.authz/0.6/credential-ref"
        },
        "sealed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "recipient_key_id",
            "ephemeral_public_key",
            "nonce",
            "ciphertext"
          ],
          "properties": {
            "alg": {
              "const": "x25519-hkdf-sha256-aes256gcm"
            },
            "recipient_key_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "ephemeral_public_key": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 44,
              "maxLength": 44
            },
            "nonce": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 16,
              "maxLength": 16
            },
            "ciphertext": {
              "type": "string",
              "contentEncoding": "base64",
              "minLength": 24,
              "maxLength": 108
            }
          }
        }
      }
    },
    "credential_revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "reason"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^cred_[a-z0-9]{8,40}$"
        },
        "reason": {
          "enum": [
            "rotated",
            "compromised",
            "asset-decommissioned",
            "operator"
          ]
        }
      }
    },
    "credential_clear_suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "version"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^cred_[a-z0-9]{8,40}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset_clear_suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "ref"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "TODO(C1): C1 asset ID"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "The C2 invocation ID whose outcome suspended the asset. The collector clears only when this, the administrator's clear-suspension.json and its own record of the suspension all match."
        }
      },
      "description": "Since 0.2 (D2-15). Sent by the node, on its own behalf, after it recorded its own asset.suspension_clear."
    },
    "admin_signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "payload",
        "signature"
      ],
      "description": "Since 0.4 (D2-11). An administrator's signed request, in place of its body, which exists only inside the payload (otsec.authz/0.5/admin-request, whose format is still otsec.authz.admin-request/0.4). The signature is Ed25519 over the bytes 'otsec.authz/0.4 admin-request <kind>' and a line feed, followed by the payload. The collector refuses an unsigned admin request, and every failed check, with admin_unverified.",
      "properties": {
        "key_id": {
          "type": "string",
          "description": "Selects the pinned admin key. Any string: an unknown or malformed ID is refused with admin_unverified, not invalid."
        },
        "algorithm": {
          "type": "string",
          "description": "Must be ed25519, or admin_unverified."
        },
        "payload": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "The exact signed JSON bytes, at most 4096 before encoding."
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "run"
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "schedule"
            }
          }
        }
      },
      "required": [
        "run"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          },
          {
            "required": [
              "admin_signed"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "credential.install"
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "credential_install"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          },
          {
            "required": [
              "admin_signed"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "credential.revoke"
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "credential_revoke"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          },
          {
            "required": [
              "admin_signed"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "credential.clear_suspension"
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "credential_clear_suspension"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          },
          {
            "required": [
              "admin_signed"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "contract": {
          "not": {
            "enum": [
              "otsec.authz/0.0",
              "otsec.authz/0.1"
            ]
          }
        },
        "kind": {
          "const": "asset.clear_suspension"
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "node"
            }
          }
        }
      },
      "required": [
        "asset_clear_suspension"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "admin_signed"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "contract": {
          "not": {
            "enum": [
              "otsec.authz/0.0",
              "otsec.authz/0.1",
              "otsec.authz/0.2",
              "otsec.authz/0.3"
            ]
          }
        },
        "kind": {
          "enum": [
            "credential.install",
            "credential.revoke",
            "credential.clear_suspension",
            "asset.clear_suspension"
          ]
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "admin_signed"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "contract": {
          "not": {
            "enum": [
              "otsec.authz/0.0",
              "otsec.authz/0.1",
              "otsec.authz/0.2",
              "otsec.authz/0.3",
              "otsec.authz/0.4"
            ]
          }
        },
        "kind": {
          "enum": [
            "node.quarantine_clear",
            "node.seq_reset_ack"
          ]
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "admin_signed"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "contract": {
          "not": {
            "enum": [
              "otsec.authz/0.0",
              "otsec.authz/0.1",
              "otsec.authz/0.2",
              "otsec.authz/0.3",
              "otsec.authz/0.4",
              "otsec.authz/0.5"
            ]
          }
        },
        "kind": {
          "enum": [
            "node.change_approval",
            "node.baseline_ack"
          ]
        },
        "on_behalf_of": {
          "properties": {
            "type": {
              "const": "human"
            }
          }
        }
      },
      "required": [
        "admin_signed"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "credential_install"
            ]
          },
          {
            "required": [
              "credential_revoke"
            ]
          },
          {
            "required": [
              "credential_clear_suspension"
            ]
          },
          {
            "required": [
              "asset_clear_suspension"
            ]
          }
        ]
      }
    }
  ]
}
